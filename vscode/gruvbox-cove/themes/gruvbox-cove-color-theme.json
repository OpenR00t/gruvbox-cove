  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      },
      "name": "Comments"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#b8bb26"
      },
      "name": "Strings"
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#fe8019"
      },
      "name": "Escapes, regex"
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#d3869b"
      },
      "name": "Constants, numbers"
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#fb4934"
      },
      "name": "Keywords"
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#fe8019"
      },
      "name": "Operators"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": "bold"
      },
      "name": "Functions"
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#fabd2f"
      },
      "name": "Types (gruvbox syntax yellow)"
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      },
      "name": "Variables"
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#d5c4a1",
        "fontStyle": "italic"
      },
      "name": "Parameters"
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#83a598"
      },
      "name": "Properties, keys"
    },
    {
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": "italic"
      },
      "name": "this/self"
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#8ec07c"
      },
      "name": "Tags"
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#fabd2f"
      },
      "name": "Attributes"
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a89984"
      },
      "name": "Punctuation"
    },
    {
      "scope": [
        "keyword.other.import",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#8ec07c"
      },
      "name": "Imports, preprocessor"
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#8ec07c"
      },
      "name": "Decorators, attributes"
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#fb4934",
        "fontStyle": "underline"
      },
      "name": "Invalid"
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#b8bb26",
        "fontStyle": "bold"
      },
      "name": "Markdown headings"
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#fbf1c7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ebdbb2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#fe8019"
      },
      "name": "Markdown code"
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#83a598"
      },
      "name": "Links"
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#bdae93",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.list punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b8bb26"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#fb4934"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#83a598"
      }
    },
    {
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.toml",
        "entity.name.tag.toml"
      ],
      "settings": {
        "foreground": "#83a598"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#8ec07c"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#83a598"
      }
    },
    {
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "scope": [
        "support.variable.drive.powershell",
        "variable.other.readwrite.powershell punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#ebdbb2"
      }
    }
  ],
  "semanticTokenColors": {
    "function": {
      "foreground": "#b8bb26",
      "bold": true
    },
    "method": {
      "foreground": "#b8bb26",
      "bold": true
    },
    "class": "#fabd2f",
    "type": "#fabd2f",
    "interface": "#fabd2f",
    "enum": "#fabd2f",
    "struct": "#fabd2f",
    "typeParameter": "#fabd2f",
    "namespace": "#8ec07c",
    "enumMember": "#d3869b",
    "parameter": {
      "foreground": "#d5c4a1",
      "italic": true
    },
    "property": "#83a598",
    "variable": "#ebdbb2",
    "variable.readonly": "#d3869b",
    "variable.defaultLibrary": "#d3869b",
    "macro": "#8ec07c",
    "decorator": "#8ec07c",
    "keyword": "#fb4934",
    "string": "#b8bb26",
    "number": "#d3869b",
    "comment": {
      "foreground": "#928374",
      "italic": true
    },
    "lifetime": "#fe8019",
    "selfKeyword": {
      "foreground": "#d3869b",
      "italic": true
    }
  }
}